{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/:path*\\.(jpg|jpeg|png|webp|gif|avif|svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/gallery",
      "destination": "/photos",
      "permanent": false
    },
    {
      "source": "/programs",
      "destination": "/photos",
      "permanent": false
    },
    {
      "source": "/news",
      "destination": "/events",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
